# Server
REPLYDOCK_HOST=127.0.0.1
REPLYDOCK_PORT=8080
REPLYDOCK_DB=./replydock.sqlite3

# Slack: create a Slack app, enable Event Subscriptions, and subscribe to message.channels.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-your-token

# WhatsApp Cloud API: configure the webhook URL and verify token in Meta Business.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0
