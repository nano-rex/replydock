# Copy to .env; server.py loads it automatically. Real environment variables take precedence.

# Server
REPLYDOCK_HOST=127.0.0.1
REPLYDOCK_PORT=8080
REPLYDOCK_DB=./replydock.sqlite3
# Password for the dashboard and /api/* (HTTP Basic auth, any username). Set this on any public server.
REPLYDOCK_ADMIN_TOKEN=

# Slack: create a Slack app, add the chat:write scope, enable Event Subscriptions,
# and subscribe to message.channels (plus message.groups / message.im if wanted).
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# 1 = reply in a thread under the incoming message, 0 = reply in the channel.
SLACK_REPLY_IN_THREAD=1

# WhatsApp Cloud API: configure the webhook URL and verify token in Meta for Developers,
# and subscribe the app to the "messages" webhook field.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0
